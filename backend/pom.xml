<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ec.edu.upse</groupId>
    <artifactId>redsocial-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>

        

    <properties>
        <compiler-plugin.version>3.13.0</compiler-plugin.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.15.1</quarkus.platform.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- RESTEasy Reactive & JSON Jackson -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-resteasy-reactive-jackson</artifactId>
        </dependency>

        <!-- Driver Oficial Neo4j para Cypher y Grafos -->
        <dependency>
            <groupId>io.quarkiverse.neo4j</groupId>
            <artifactId>quarkus-neo4j</artifactId>
            <version>4.4.0</version>
        </dependency>

        <!-- WebSockets para Chat Bidireccional en Tiempo Real -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets</artifactId>
        </dependency>

        <!-- Cliente S3 / MinIO para Almacenamiento Multimedia -->
        <dependency>
            <groupId>io.quarkiverse.amazonservices</groupId>
            <artifactId>quarkus-amazon-s3</artifactId>
            <version>2.18.1</version>
        </dependency>
        <!-- Exigido en build-time por AmazonServicesClientsProcessor de la extensión -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>2.27.20</version>
        </dependency>

        <!-- Web Push VAPID Notification Support -->
        <dependency>
            <groupId>nl.martijndwars</groupId>
            <artifactId>web-push</artifactId>
            <version>5.1.1</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!-- SmallRye JWT y Seguridad -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-jwt</artifactId>
        </dependency>

        <!-- Extensión de build: permite firmar JWT ( issuers/keys ) desde código -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-jwt-build</artifactId>
        </dependency>

        <!-- Quarkus Arc Dependency Injection & SmallRye OpenAPI -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>

        <!-- Test: extension de test de Quarkus. Aporta JUnit 5 y configura Surefire. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test: Mockito para aislar adaptadores de infraestructura. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test: base en memoria para consultas Cypher sin depender de un Neo4j externo. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>neo4j</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Test: sustitutos de Mockito para @QuarkusTest.

            Allows asserting on the response BODY of a route with the server up, without touching
            the graph. @InjectMock fails without it, with an IllegalStateException that does not say
            which dependency is missing.

            Deliberately NOT active: the artifact is not in this machine's local repository and the
            build runs without access to Maven Central, so enabling it leaves the project unable to
            compile. With the block uncommented, `mvn verify` fails with "could not be resolved":
            that is the cause, and the fix is to re-comment it or get network.

            To restore body-level assertions in PerfilAjenoRutasIT, uncomment and re-run.
        -->
        <!--
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        -->

        <!-- Test: pruebas de REST sobre el recurso, sin levantar el servidor. -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Formato: Spotless con google-java-format.

                Elección sobre las alternativas: Spotless es un plugin de Maven, así que
                `spotless:check` se ata al ciclo de vida y `spotless:apply` repara todo de
                una. Alternativas descartadas: google-java-format suelto obliga a un
                script aparte y no se integra con Maven; el fmt-maven-plugin usa palantir,
                menos conocido. Google Java Format es el estándar de facto y es
                determinista: el mismo código produce siempre el mismo formato.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.44.0</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <googleJavaFormat>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Lint: SpotBugs.

                Elección sobre las alternativas: SpotBugs encuentra bugs reales
                (desreferencias nulas, fugas de recursos, condiciones de carrera) en el
                bytecode ya compilado, que es justo lo que `javac` no reporta. Descartado
                Checkstyle porque su mayor valor es el estilo, y eso ya lo cubre Spotless:
                usar ambos juntos sólo genera conflictos. Descartado PMD por solaparse con
                SpotBugs. Descartado Error Prone por ser intrusivo: reemplaza el
                compilador y obliga a flags como -XDcompilePolicy, lo que puede romper la
                compilación de Quarkus. Se deja en nivel medio para dar señal alta
                sin ruido.
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.8.6.0</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Surefire recoge también los *IT.

                Lo natural sería dejar las pruebas de integración para maven-failsafe-plugin, que
                es el plugin pensado para ellas, pero su artefacto no está en el repositorio local
                de esta máquina y el build corre sin acceso a Maven Central: añadirlo dejó el
                proyecto sin poder compilar. Recoger los *IT aquí da el mismo resultado observable
                (las consultas se ejecutan contra un Neo4j de verdad) sin una dependencia que no
                se puede resolver. Si algún día hay red y se añade failsafe, esto se revierte y
                vuelve a ser la fase verify la que corre las de integración.

                El contenedor se levanta una vez por clase y se salta solo con
                `disabledWithoutDocker`, así que una máquina sin Docker sigue teniendo el build en
                verde en vez de romperse.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
