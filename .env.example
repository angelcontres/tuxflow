# ==============================================================================
# Variables de Entorno para Despliegue en AWS
# ==============================================================================
# Copia este archivo como .env si deseas personalizar puertos o endpoints.

# Puerto público en el que el navegador accederá a la aplicación web (por defecto 3000 o 80)
FRONTEND_PORT=3000

# Endpoint público para que los navegadores puedan cargar imágenes y avatares de MinIO.
# Con Cloudflare Tunnel: https://s3.tudominio.com
S3_PUBLIC_ENDPOINT=http://localhost:9000

# (Opcional) Token de Cloudflare Tunnel si deseas que el túnel corra dentro de Docker
# Si se define, Docker levantará el contenedor de Cloudflare automáticamente
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
